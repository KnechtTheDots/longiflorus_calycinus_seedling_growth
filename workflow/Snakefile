
# the target rule gives snakemake the final results to be generated and snakemake maps the inputs needed
# for them and executes the workflow
rule target:
    input:
        panel="report/plots/survival_mod_panel.png",
        epi="report/plots/epi.png",
        obs="report/plots/obs.png",
        mean_diffs="report/plots/mean_diffs.png",
        traits="report/posteriors/traits.csv",
        betas="report/posteriors/betas.csv",
        diffs="report/posteriors/diffs.csv",
        corrs="report/posteriors/corrs.csv",
        ppc="report/plots/ppc.png"

# this rule takes the files from data collectio and creates the set 
# of files that will be used for the analysis

rule data_wrangling:
    input:
        day_4="resources/day_4_areas.csv",
        day_17="resources/day_17_areas.csv",
        ids="resources/germ_and_id.csv",
        height="resources/heights.csv",
        drought="resources/seed_growth_vs_seed_size.csv"
    output:
        traits="results/wrangled/traits.csv",
        long="results/wrangled/drought_long.csv",
        short="results/wrangled/drought_short.csv"
    log:
        log="results/logs/data_wrangling.log"
    conda:
        "envs/environment.yaml"
    script:
        "scripts/data_wrangling.R"

# this rule doesn't really do anything, it just spits out a file that says "stan files updated", the purpose of the
# rule is to get the stan files as input in the workflow so that when they are modified it triggers the workflow
# to re-create anything that is dependent them.

rule stan_compile:
    input:
        rgr="workflow/scripts/stan/drought_survival_rgr.stan",
        sze="workflow/scripts/stan/drought_survival_size.stan",
        rgr_size="workflow/scripts/stan/drought_survival_rgr_size.stan"
    output:
        "workflow/scripts/stan/compile_complete.txt"
    log:
        log="results/logs/compile.log"
    conda:
        "envs/environment.yaml"
    shell:
        """
        (echo Stan files are up to date! > {output}) 2> {log}
        """

# run the stan code to fit the growth rate/survival model

rule drought_survival:
    input:
        long="results/wrangled/drought_long.csv",
        short="results/wrangled/drought_short.csv",
        traits="results/wrangled/traits.csv",
        compiled="workflow/scripts/stan/compile_complete.txt"
    output:
        rgr="results/drought_survival_rgr.RDS",
        sze="results/drought_survival_size.RDS",
        rgr_size="results/drought_survival_rgr_size.RDS"
    params:
        rgr="workflow/scripts/stan/drought_survival_rgr.stan",
        sze="workflow/scripts/stan/drought_survival_size.stan",
        rgr_size="workflow/scripts/stan/drought_survival_rgr_size.stan"
    log:
        log="results/logs/drought_survival_model.log"
    conda:
        "envs/environment.yaml"
    script:
        "scripts/drought_survival.R"

# conduct posterior predictive checks to validate the models and make a plot showing the results of the checks

rule post_pred_checks:
    input:
        fit="results/drought_survival_rgr.RDS",
        short="results/wrangled/drought_short.csv"
    output:
        "report/plots/ppc.png"
    log:
        log="results/logs/post_pred_checks.log"
    conda:
        "envs/environment.yaml"
    script:
        "scripts/ppc_plots.R"

# create plots showing the relationship between the traits in the drought trial and survival in the drought trial

rule survival_plots:
    input:
        size_mod="results/drought_survival_size.RDS",
        rgr_mod="results/drought_survival_rgr.RDS",
        rgr_size_mod="results/drought_survival_rgr_size.RDS",
        short="results/wrangled/drought_short.csv",
        long="results/wrangled/drought_long.csv"
    output:
        panel="report/plots/survival_mod_panel.png",
        comb_only="report/plots/survival_combined_mod.png"
    log:
        log="results/logs/survival_plots.log"
    conda:
        "envs/environment.yaml"
    script:
        "scripts/survival_plots.R"

# Run the bayesian bootstrap for the epistasis test and creat csv's containing the results

rule trait_boots:
    input:
        traits="results/wrangled/traits.csv"
    output:
        survive="results/trait_boots/survive.csv",
        day_4="results/trait_boots/day_4.csv",
        day_17="results/trait_boots/day_17.csv",
        rgr="results/trait_boots/rgr.csv",
        height="results/trait_boots/height.csv"
    log:
        log="results/logs/trait_boots.log"
    conda:
        "envs/environment.yaml"
    script:
        "scripts/trait_boots.R"

# plot the results of the epistasis test (as well as differences between lines and the raw observations)

rule epi_plots:
    input:
        survive="results/trait_boots/survive.csv",
        day_4="results/trait_boots/day_4.csv",
        day_17="results/trait_boots/day_17.csv",
        rgr="results/trait_boots/rgr.csv",
        height="results/trait_boots/height.csv",
        traits="results/wrangled/traits.csv"
    output:
        epi="report/plots/epi.png",
        obs="report/plots/obs.png",
        mean_diffs="report/plots/mean_diffs.png"
    log:
        log="results/logs/epi_plots.log"
    conda:
        "envs/environment.yaml"
    script:
        "scripts/epi_plots.R"

# generate csv's containing the posterior intervals (95% and 50%) and mean of all quantities described

rule get_posterior:
    input:
        survive="results/trait_boots/survive.csv",
        day_4="results/trait_boots/day_4.csv",
        day_17="results/trait_boots/day_17.csv",
        rgr="results/trait_boots/rgr.csv",
        height="results/trait_boots/height.csv",
        mod_size="results/drought_survival_size.RDS",
        mod_rgr="results/drought_survival_rgr.RDS",
        mod_rgr_size="results/drought_survival_rgr_size.RDS",
        short="results/wrangled/drought_short.csv",
        long="results/wrangled/drought_long.csv"
    output:
        traits="results/posteriors/traits.csv",
        betas="results/posteriors/betas.csv",
        diffs="results/posteriors/diffs.csv",
        corrs="results/posteriors/corrs.csv"
    log:
        log="results/logs/get_posteriors.log"
    conda:
        "envs/environment.yaml"
    script:
        "scripts/get_posteriors.R"

# this rule takes the csv's and alters them so that they can be made easily into latex tables
rule csv2table:
    input:
        traits="results/posteriors/traits.csv",
        betas="results/posteriors/betas.csv",
        diffs="results/posteriors/diffs.csv",
        corrs="results/posteriors/corrs.csv"
    output:
        traits="report/posteriors/traits.csv",
        betas="report/posteriors/betas.csv",
        diffs="report/posteriors/diffs.csv",
        corrs="report/posteriors/corrs.csv"
    log:
        log="results/logs/csv2table.log"
    conda:
        "envs/environment.yaml"
    script:
        "scripts/csv2table.R"
